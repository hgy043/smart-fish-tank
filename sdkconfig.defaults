# ============================================================================
# sdkconfig.defaults — 智能鱼缸项目默认配置
#
# 所有取值均来自已验证工程的构建产物 (build/config.env 记录 IDF 5.5.3)，
# 不是猜测值。修改此文件后需执行 idf.py reconfigure 或删除 build 目录。
# ============================================================================

# ---------------------------------------------------------------------------
# 目标芯片与存储
# ---------------------------------------------------------------------------
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# ---------------------------------------------------------------------------
# 芯片运行频率
#
# ⚠️ 实测对齐：粤嵌官方例程 06-tcp_client_bafa_mqtt 的 sdkconfig 用 **240MHz**，
# 而本工程此前是 IDF 默认的 160MHz。该例程在同一块板上 LCD **能正常出图**，
# 而本项目不能 —— 在排除其他差异前，先把这项对齐，减少变量。
#
# 参考：`D:\ESP32\06-tcp_client_bafa_mqtt\sdkconfig`
#   CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
#   CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# ---------------------------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 闪存模式对齐参考工程（QIO）
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# 电源管理 IRAM 优化（参考工程启用，本项目此前未启用）
CONFIG_PM_SLEEP_FUNC_IN_IRAM=y
CONFIG_PM_SLP_IRAM_OPT=y

# ---------------------------------------------------------------------------
# PSRAM：必须为 Octal 模式 @80MHz
#   ESP32-S3-WROOM-1-N16R8 的 R8 后缀表示 8MB Octal PSRAM。
#   摄像头帧缓冲、LVGL 绘制缓冲都依赖它，配置错误会直接启动失败。
# ---------------------------------------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# ---------------------------------------------------------------------------
# FreeRTOS 时基
#   100Hz => 1 tick = 10ms。
#   硬性影响：vTaskDelay 的最小有效单位是 10ms，所有任务节拍必须是 10ms
#   的整数倍；ui_task 要求的 30ms 刷新周期需用 vTaskDelayUntil 累积实现。
# ---------------------------------------------------------------------------
CONFIG_FREERTOS_HZ=100

# ---------------------------------------------------------------------------
# 分区表
# ---------------------------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

# ---------------------------------------------------------------------------
# 编译期质量门禁
#
# 本项设为 n 后，实际生效的编译标志为（已由 build/compile_commands.json 核实）：
#   -Wall -Werror -Wextra
#   -Wno-error=unused-function -Wno-error=unused-variable
#   -Wno-error=unused-but-set-variable -Wno-error=deprecated-declarations
#   -Wno-error=extra -Wno-unused-parameter -Wno-sign-compare
#   -Wno-enum-conversion -Wno-old-style-declaration
#
# 【实测结论，勿轻信猜测】IDF 会**无条件**把一批常见警告排除在 -Werror 之外
# （unused-variable、unused-function、extra、deprecated-declarations 等），
# 本项开关**不会**改变这一点。已用「故意定义一个未使用静态变量」验证：
# 只报 warning，构建仍然成功。
#
# 因此本项的真实作用是：让 IDF 默认列表之外的其它警告以错误形式中断构建。
# 要真正捕获「未使用变量」这类问题，必须**人工检查构建日志中的 warning**，
# 或按下面的做法让组件自己强制：
#
#   set_source_files_properties(app_main.c PROPERTIES
#       COMPILE_OPTIONS "-Werror=unused-variable;-Werror=unused-function")
#
# 本项目当前依赖「构建后人工核对 warning 数量为 0」，尚未逐文件加固。
# ---------------------------------------------------------------------------
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=n

# ---------------------------------------------------------------------------
# 网络（Wi-Fi / lwIP）
#
# ⚠️ 实测教训：MQTT 的缓冲与任务栈**不能**在这里配。
#   CONFIG_MQTT_BUFFER_SIZE / CONFIG_MQTT_TASK_STACK_SIZE 等项在
#   ESP-IDF 里都 `depends on MQTT_USE_CUSTOM_CONFIG`（默认 n），
#   写在 sdkconfig.defaults 里会被 kconfig **静默忽略**，不报任何错。
#   必须在 esp_mqtt_client_config_t 的 .buffer.size / .task.stack_size
#   里设置 —— 见 components/net_service/bafa_mqtt.c。
#   排查方法：配置写完一定要回头 grep 生成的 sdkconfig 确认真的生效了。
# ---------------------------------------------------------------------------
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_NVS_ENABLED=y
# 巴法云走明文 TCP 9501，不需要 TLS；如需 9503 加密端口再打开
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
# lwIP socket 数：MQTT + 后续 HTTP(AI/OTA) + DNS 并发，默认 10 偏紧
CONFIG_LWIP_MAX_SOCKETS=16

# ---------------------------------------------------------------------------
# LVGL（P2 接入）
#
# ⚠️ 顺序陷阱（与上面 MQTT 那条同类）：
#   CONFIG_LV_* 符号在 lvgl 组件被 component manager **拉下来之前不存在**。
#   若在没有该组件时先写这些配置，kconfig 会**静默丢弃**，不报任何错。
#   正确顺序：① 改 main/idf_component.yml → ② idf.py reconfigure 拉组件
#             → ③ 再写本段 → ④ reconfigure → ⑤ grep sdkconfig 复核生效
#
# 本段的取值**对齐参考工程 xiaozhi-esp32-1.9.4-gec**（两工程同 IDF 5.5.3）。
# ---------------------------------------------------------------------------

# 用 Kconfig 而非手写 lv_conf.h（LVGL 9 的官方推荐方式）
CONFIG_LV_CONF_SKIP=y

# --- 内存分配：用标准 C 库，**不要**用 LVGL 自带内存池 ---
# LVGL 自带的 BUILTIN_MALLOC 会在内部 RAM 里锁死一个固定池
# （LV_MEM_SIZE_KILOBYTES 默认 64KB），无法增长、也无法落到 PSRAM。
# 改用 CLIB 后 LVGL 走 IDF 堆，后续接图片资源（PNG 解码帧等）才能利用 PSRAM。
CONFIG_LV_USE_CLIB_MALLOC=y
# 字符串与格式化也走 C 库，省 flash
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y

# --- 字体：完整字库需要这一项 ---
# 78/xiaozhi-fonts 组件的 CMakeLists 用 file(GLOB src/*.c) 编译**全部**字体，
# 其中的 30px 字号字形偏移超出 LVGL 默认的 20 位上限，会直接：
#     #error "Too large font or glyphs in FONT_PUHUI_30_4.
#             Enable LV_FONT_FMT_TXT_LARGE in lv_conf.h"
# 并伴随大量 -Werror=overflow。参考工程 xiaozhi 同样是开着的。
CONFIG_LV_FONT_FMT_TXT_LARGE=y

# 78/xiaozhi-fonts 的 emoji 字体（font_emoji_32/64.c）调用 lv_imgfont_create()，
# 该函数由本特性提供。不开启会编不过（implicit declaration）。
# P2 的界面用不到 emoji，但该组件的 CMakeLists 用 GLOB 编译**全部**字体文件，
# 无法只挑需要的编。参考工程 xiaozhi 同样是开着的。
CONFIG_LV_USE_IMGFONT=y

# --- 日志：首轮点亮与调色期间开启，便于看到 LVGL 自身的告警与断言 ---
# 界面稳定后可关掉省一点 flash。
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y

# 注：以下各项**用 Kconfig 默认即可，不需在此重复写**（已逐项核对默认值）
#   CONFIG_LV_COLOR_DEPTH=16、CONFIG_LV_DEF_REFR_PERIOD=33、
#   CONFIG_LV_OS_NONE、CONFIG_LV_USE_THEME_DEFAULT、CONFIG_LV_USE_FLEX/GRID、
#   CONFIG_LV_USE_ASSERT_NULL/MALLOC
# 也**不要**抄 xiaozhi 的 PNG/GIF/BMP/IMGFONT/OBSERVER/DEMOS —— P2 用不上。

# ============================================================================
# 摄像头（P6-a）—— espressif/esp32-camera
# ============================================================================
# 板上 sensor 型号 —— **实测结果，不是按型号名猜的**（2026-10-13 上板）：
#     camera: Camera PID=0x9b ... Detected GC0308 camera
#     camera: Detected camera at address=0x21
# 是 GC0308（I2C 0x21），**不是** OV2640（那会是 0x30 / PID 0x26）。
# 这一项确保把 GC0308 的寄存器表编译进来（Kconfig 默认本就开，显式写死防将来被关）。
CONFIG_GC0308_SUPPORT=y
# OV2640 一并留着：驱动的探测表是逐个试的，多编一颗不影响本板，
# 却能让换 sensor 时不必改配置。（诊断日志里那些 "Mismatch PID" 就是探测过程。）
CONFIG_OV2640_SUPPORT=y

# SCCB 走**新** I2C master 驱动（IDF ≥5.4 的默认值，这里显式写死防止将来被改）。
# 旧驱动(sccb.c)用的是 driver/i2c.h 的老 API，与本工程的 i2c_master 总线模型
# 不是一回事 —— 选错了 SCCB 会自己去 i2c_driver_install，与已有总线打架。
CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW=y

# DMA 缓冲上限：32KB(Kconfig 默认) → 8KB
# 这块必须在**内部 RAM**（要 DMA 可达），是摄像头最大的内部 RAM 开销。
# 8KB 是 xiaozhi 在同一块板上的取值，属已验证值，不是猜的。
# 若日后画面撕裂/丢帧，可往上调，但要盯住 monitor_task 的内部堆余量（≥30%）。
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=8192

